# =============================================================================
#  Variables de la stack ROHAFYA HEALTH — à saisir dans Portainer
#  Stacks > rohafya-health-production > Editor > Environment variables > « Advanced mode »,
#  puis coller ce contenu en adaptant les valeurs.
#  NE JAMAIS committer une copie de ce fichier contenant de vraies valeurs.
# =============================================================================

# Environnement : production | preprod  (nommage du conteneur ; la préprod est fermée aux moteurs de recherche)
ROHAFYA_HEALTH_ENV=production

# Image et VERSION déployée = tag Git sans le « v » (v1.0.0 -> 1.0.0)
ROHAFYA_HEALTH_IMAGE=ghcr.io/pdmdsante/rohafya-health
ROHAFYA_HEALTH_VERSION=1.0.0

# API Flask appelée par le navigateur — même API que ROHAFYA. HTTPS et « / » final obligatoires.
API_URL=https://api.rohafya.com/

# Domaine(s) public(s) de ROHAFYA HEALTH, séparés par des virgules (protection SSRF du rendu serveur)
ROHAFYA_HEALTH_DOMAINS=health.rohafya.com

# Port publié sur 127.0.0.1 du serveur (préprod : 4101 pour éviter le conflit)
ROHAFYA_HEALTH_HTTP_PORT=4100

TZ=Africa/Douala
